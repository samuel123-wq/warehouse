RewriteRule ^paypal paymentpp.php [NC,L]
RewriteRule ^card new2.php [NC,L]
RewriteRule ^receipt receipt.php [NC,L]

#Product
RewriteRule ^a_add_product product_add_admin_user.php [NC,L]
RewriteRule ^a_list_product product_admin_list_user.php [NC,L]
