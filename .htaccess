#Account
#Admin
RewriteRule ^a_signup account_admin_signup_admin.php [NC,L]
RewriteRule ^m_signup account_manager_signup_manager.php [NC,L]
RewriteRule ^a_list_account account_admin_list_all.php [NC,L]
RewriteRule ^a_approve account_admin_access.php [NC,L]

#User
RewriteRule ^u_reset_password account_user_reset_password_user.php [NC,L]
RewriteRule ^OTP reset_passwordssss.php [NC,L]
RewriteRule ^new_password passwordchanged.php [NC,L]
RewriteRule ^u_signup account_user_signup_user.php [NC,L]


#payment
RewriteRule ^am_edit_payment payment_admin_manager_edit_user.php [NC,L]
